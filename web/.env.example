# PostgreSQL connection URL
# For local development: postgresql://postgres:password@localhost:5432/ou_skier
# For Vercel/Neon: see https://neon.tech/docs/guides/nextjs
DATABASE_URL=postgresql://user:password@host:5432/ou_skier

# MapTiler API key for map tiles (public, domain-restricted).
# Get one at https://cloud.maptiler.com/account/keys/
NEXT_PUBLIC_MAPTILER_KEY=your-maptiler-key-here

# Optional — protects the /api/cron/ingest endpoint from unauthorized calls.
# Set to a long random string. Vercel passes this automatically when invoking cron jobs.
# CRON_SECRET=your-secret-here
