generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Region {
  AUVERGNE_RHONE_ALPES        @map("Auvergne-Rhône-Alpes")
  BOURGOGNE_FRANCHE_COMTE     @map("Bourgogne-Franche-Comté")
  BRETAGNE                    @map("Bretagne")
  CENTRE_VAL_DE_LOIRE         @map("Centre-Val de Loire")
  CORSE                       @map("Corse")
  GRAND_EST                   @map("Grand Est")
  HAUTS_DE_FRANCE             @map("Hauts-de-France")
  ILE_DE_FRANCE               @map("Île-de-France")
  NORMANDIE                   @map("Normandie")
  NOUVELLE_AQUITAINE          @map("Nouvelle-Aquitaine")
  OCCITANIE                   @map("Occitanie")
  PAYS_DE_LA_LOIRE            @map("Pays de la Loire")
  PROVENCE_ALPES_COTE_D_AZUR  @map("Provence-Alpes-Côte d'Azur")

  @@map("region")
}

model Resort {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  region      Region?
  domainUrl   String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  snowRecords SnowRecord[]
}

model SnowRecord {
  id            Int      @id @default(autoincrement())
  resortId      Int
  resort        Resort   @relation(fields: [resortId], references: [id])
  recordDate    DateTime
  openSlopes    Int?
  totalSlopes   Int?
  notes         String?
  sourceUrl     String?
  createdAt     DateTime @default(now())

  @@unique([resortId, recordDate])
}
