model Resort {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  region      Region?
  department  Department?
  domainUrl   String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  snowRecords SnowRecord[]
}

model SnowRecord {
  id            Int      @id @default(autoincrement())
  resortId      Int
  resort        Resort   @relation(fields: [resortId], references: [id])
  recordDate    DateTime
  openSlopes    Int?
  totalSlopes   Int?
  snowDepthBase Float?
  snowDepthTop  Float?
  freshSnow     Float?
  notes         String?
  sourceUrl     String?
  createdAt     DateTime @default(now())

  @@unique([resortId, recordDate])
}
