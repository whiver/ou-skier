# PostgreSQL connection URL
# For local development: postgresql://postgres:password@localhost:5432/ou_skier
# For Vercel/Neon: see https://neon.tech/docs/guides/nextjs
DATABASE_URL=postgresql://user:password@host:5432/ou_skier

# Optional but recommended — webhook called after successful ingestion to invalidate web cache.
# WEB_REVALIDATE_URL=https://ouskier.vercel.app/api/revalidate
# WEB_REVALIDATE_SECRET=your-secret-here
